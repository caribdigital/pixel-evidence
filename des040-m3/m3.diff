 /* Flowing Current Background Pattern */
@@ -193,6 +196,38 @@
     }
 }
 
+/* CLC-DES-040 M3 item 1 (D-040-MOTION-SYSTEM / D-040-M3-RULINGS, Kai): one-time nav ENTRANCE.
+   A subtle fade-up cascade across the top-level nav items as the shell first paints — the
+   register's "arrive, then rest" sentence for the sidebar. Pure CSS keyed to element mount,
+   so it plays once per circuit and NEVER on a data refresh or same-context re-render (Blazor
+   diffs the persistent MudNavMenu rather than recreating it; only genuinely new sections that
+   appear after a context switch will fade in, which is a real appearance, not a refresh).
+   Transform + opacity only.
+
+   TIMING (ratified, D-040-M3-RULINGS, Kai — the #4062 spec text is amended in writing here, not
+   silently): per-item duration = --motion-medium (240ms), stagger step 20ms, cap at 8 items
+   (items 9+ share the 8th's delay and arrive together). Each individual animation stays under
+   the 300ms register cap; the whole cascade tail is bounded — the last item starts at 140ms and
+   ends at 380ms, under the ratified 400ms sequence-tail hard ceiling. (A ~100ms per-item entrance
+   read as flicker; the 240ms cascade reads as grace — Kai's ratification of Anya's reading.)
+   Collapses under the nav reduced-motion block below. */
+.coral-nav-content .mud-navmenu > * {
+    animation: coral-nav-entrance var(--motion-medium) var(--motion-ease-standard) both;
+}
+.coral-nav-content .mud-navmenu > *:nth-child(1) { animation-delay: 0ms; }
+.coral-nav-content .mud-navmenu > *:nth-child(2) { animation-delay: 20ms; }
+.coral-nav-content .mud-navmenu > *:nth-child(3) { animation-delay: 40ms; }
+.coral-nav-content .mud-navmenu > *:nth-child(4) { animation-delay: 60ms; }
+.coral-nav-content .mud-navmenu > *:nth-child(5) { animation-delay: 80ms; }
+.coral-nav-content .mud-navmenu > *:nth-child(6) { animation-delay: 100ms; }
+.coral-nav-content .mud-navmenu > *:nth-child(7) { animation-delay: 120ms; }
+.coral-nav-content .mud-navmenu > *:nth-child(n+8) { animation-delay: 140ms; }
+
+@keyframes coral-nav-entrance {
+    from { opacity: 0; transform: translateY(6px); }
+    to   { opacity: 1; transform: translateY(0); }
+}
+
 /* Link Icons — CLC-DES-040 M2 item 2 (D-040-MOTION-SYSTEM, Kai): nav-active fill.
    Ruled: inactive icons rest at 0.72 opacity in the sidebar ink; activation cross-fades
    to full opacity in Reef Aqua alongside the existing active background, 180ms ease-out.
@@ -385,6 +420,13 @@
     .mud-drawer::before {
         animation: none;
     }
+
+    /* M3 item 1: nav entrance collapses to the settled state (no fade-up). */
+    .coral-nav-content .mud-navmenu > * {
+        animation: none;
+        opacity: 1;
+        transform: none;
+    }
 }
 
 /* Mobile Adjustments */
