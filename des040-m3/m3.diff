diff --git a/src/CoralComply.Web/Components/Shared/SavedIndicator.razor b/src/CoralComply.Web/Components/Shared/SavedIndicator.razor
new file mode 100644
index 00000000..b07252c9
--- /dev/null
+++ b/src/CoralComply.Web/Components/Shared/SavedIndicator.razor
@@ -0,0 +1,25 @@
+@* CLC-DES-040 M3 item 4 — silent success (D-040-MOTION-SYSTEM, Kai; hallmark principle adopted).
+   The inline, subtle confirmation for a ROUTINE save: a small check that draws itself in next to
+   "Saved", in place of a toast. A routine save is not an event that deserves a banner — the quiet
+   inline mark is the register's whole sentence for it.
+
+   Scope note (deliberate): this is for routine saves ONLY. The import receipt and the Filing A2
+   card are DOCUMENTS / regulatory moments and keep their full ceremony — do NOT replace those with
+   this. Parent-controlled: flip Visible=true on a successful save; the check draws in once and the
+   label fades in. aria-live="polite" announces it to assistive tech. prefers-reduced-motion
+   collapses the motion (DrawnCheck + the label fade both respect it) — the mark still appears. *@
+@if (Visible)
+{
+    <span class="coral-saved-indicator" role="status" aria-live="polite" data-testid="saved-indicator">
+        <DrawnCheck Size="16" AriaLabel="@Label" />
+        <span class="coral-saved-indicator__label">@Label</span>
+    </span>
+}
+
+@code {
+    /// <summary>Set true on a successful routine save to show the inline confirmation.</summary>
+    [Parameter] public bool Visible { get; set; }
+
+    /// <summary>The confirmation label. Default "Saved".</summary>
+    [Parameter] public string Label { get; set; } = "Saved";
+}
diff --git a/src/CoralComply.Web/wwwroot/css/03-mudblazor-overrides.css b/src/CoralComply.Web/wwwroot/css/03-mudblazor-overrides.css
index 530c9ee6..eb0c2548 100644
--- a/src/CoralComply.Web/wwwroot/css/03-mudblazor-overrides.css
+++ b/src/CoralComply.Web/wwwroot/css/03-mudblazor-overrides.css
@@ -295,6 +295,39 @@ body:not(.mud-theme-dark) .theme-icon-wrap {
     to   { opacity: 1; transform: scale(1); }
 }
 
+/* ── M3 item 3: state-chip cross-fade on change (D-040-MOTION-SYSTEM, Kai) ────────────────
+   The reusable register form of the M2 resolve cross-fade: any status chip that changes value
+   opts in with `Class="coral-chip-crossfade"` to settle the new state over 150ms (opacity +
+   slight scale, ease-standard, transform+opacity only). Apply it only where the chip genuinely
+   transitions in response to a state change — NOT blanket on grid chips that re-render on every
+   data refresh (magnitude/count never animates; that is the count-up ban). Collapses under the
+   reduced-motion block. This is the same 150ms recipe as `.resolve-crossfade`, named for reuse. */
+.coral-chip-crossfade {
+    animation: resolve-crossfade-in 150ms var(--motion-ease-standard) both;
+}
+
+/* ── M3 item 4: silent-success inline confirmation (D-040-MOTION-SYSTEM, Kai) ──────────────
+   The quiet "Saved" mark for routine saves (SavedIndicator). The check draws itself in
+   (DrawnCheck primitive); the label fades in beside it over --motion-small. Muted success ink,
+   transform+opacity only. Reduced-motion: the label fade collapses via the block below and the
+   check via its own rule — the mark still shows, just without motion. */
+.coral-saved-indicator {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    color: var(--mud-palette-success, #10B981);
+    font-size: 0.8125rem;
+    line-height: 1;
+}
+.coral-saved-indicator__label {
+    animation: coral-saved-label-in var(--motion-small) var(--motion-ease-standard) both;
+}
+
+@keyframes coral-saved-label-in {
+    from { opacity: 0; transform: translateX(-2px); }
+    to   { opacity: 1; transform: translateX(0); }
+}
+
 /* ── M2 chevrons: bring MudBlazor's own expand-icon rotation onto the token system ──
    CLC-DES-040 M2 item 1 (D-040-MOTION-SYSTEM). MudBlazor 7.11.0 ALREADY rotates the
    expand-panel and nav-group chevrons 180° on `.mud-transform` — but with a hardcoded
@@ -309,6 +342,39 @@ body:not(.mud-theme-dark) .theme-icon-wrap {
                 visibility 0s;
 }
 
+/* ── M3 item 2: dialog + drawer entrance onto the token system (D-040-MOTION-SYSTEM /
+   D-040-M3-RULINGS, Kai) ──
+   Surfaces that ARRIVE (a dialog opening, the mobile drawer sliding in) do so over
+   --motion-medium (240ms), one-way ease-standard, transform + opacity only. The dialog rises
+   a few px as it fades — the register's "arrive" for a modal moment; the scrim fades with it.
+   No layout properties animate. One-shot on open (`both` holds the settled state); the global
+   + local reduced-motion blocks collapse it to an instant appear. The drawer's own width
+   collapse tween is retargeted onto the token in 05-navigation.css (a one-token change).
+
+   DOUBLE-TRANSFORM CHECK (D-040-M3-RULINGS, Kai): MudBlazor's bundle already animates
+   `.mud-dialog` with `animation: mud-open-dialog-center .1s ... both`. This file loads AFTER
+   MudBlazor at equal specificity, so the `animation` shorthand below REPLACES MudBlazor's on the
+   same element — exactly one animation runs, so no element ever carries two transforms. The
+   overlay rule animates opacity ONLY (no transform), so it cannot double up either. */
+.mud-dialog {
+    animation: motion-dialog-in var(--motion-medium) var(--motion-ease-standard) both;
+}
+
+@keyframes motion-dialog-in {
+    from { opacity: 0; transform: translateY(8px); }
+    to   { opacity: 1; transform: translateY(0); }
+}
+
+.mud-overlay-dialog .mud-overlay,
+.mud-overlay.mud-overlay-scrim {
+    animation: motion-overlay-in var(--motion-medium) var(--motion-ease-standard) both;
+}
+
+@keyframes motion-overlay-in {
+    from { opacity: 0; }
+    to   { opacity: 1; }
+}
+
 /* ===== CARDS ===== */
 
 .mud-paper {
@@ -905,17 +971,27 @@ body:not(.mud-theme-dark) .theme-icon-wrap {
        usually never even applied — this is the CSS-level guarantee for any other entry point.) */
     .drawn-check__path,
     .dashed-ring__solid,
-    .resolve-crossfade {
+    .resolve-crossfade,
+    .mud-dialog,
+    .mud-overlay-dialog .mud-overlay,
+    .mud-overlay.mud-overlay-scrim,
+    .coral-chip-crossfade {
         animation: none;
     }
     .drawn-check__path,
     .dashed-ring__solid {
         stroke-dashoffset: 0;
     }
-    .resolve-crossfade {
+    .resolve-crossfade,
+    .mud-dialog,
+    .coral-chip-crossfade,
+    .coral-saved-indicator__label {
         opacity: 1;
         transform: none;
     }
+    .coral-saved-indicator__label {
+        animation: none;
+    }
 }
 
